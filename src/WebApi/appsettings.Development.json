{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=pms-application;Username=sa;Password=123456aA@;",
    "HealthCheckConnection": "Host=localhost;Port=5432;Database=pms-application-health;Username=sa;Password=123456aA@;",
    "EventStore": "esdb://localhost:2113?tls=false"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "WriteTo": [
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <s:{SourceContext}>{NewLine}{Exception}"
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [
            {
              "key": "file-manager-service",
              "value": "Edge-Services Version 1.0"
            }
          ],
          "propertiesAsLabels": [
            "file-manager-service"
          ]
        }
      }
    ]
  }
}
